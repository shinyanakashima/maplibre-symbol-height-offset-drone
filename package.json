{
  "name": "maplibre-drone-flight-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DJI WPML (KMZ) の飛行計画を MapLibre GL JS の symbol-height-offset で3D可視化するビューア",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
